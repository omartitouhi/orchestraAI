# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=orchestra
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra

# Host port of the backend (change it if 8080 is already used)
BACKEND_PORT=8080

# Model called by the AI service, as a LiteLLM name. Cloud models go through OpenRouter.
# Examples: openrouter/anthropic/claude-haiku-5.5, openrouter/openai/gpt-5-mini, ollama/llama3.2
LLM_MODEL=openrouter/anthropic/claude-haiku-5.5
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Ollama on the host machine (local models), seen from inside the container
OLLAMA_API_BASE=http://host.docker.internal:11434
